file(WRITE "${FIXTURE}" [=[{"schema":1,"component":"server","instance":"test-instance","from_version":"0.4.0","to_version":"0.4.1-preview.1","phase":"staged","pending":"verified_target","rollback_boundary":"source_preserved","requires_admin":true,"unused":"fixture-secret"}]=])
file(SHA256 "${FIXTURE}" before)
execute_process(COMMAND "${PROGRAM}" --update-status "${FIXTURE}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "Offline status failed: ${error}")
endif()
foreach(field IN ITEMS component instance from_version to_version phase pending rollback_boundary requires_admin schema)
    string(JSON actual GET "${output}" "${field}")
    file(READ "${FIXTURE}" fixture_json)
    string(JSON expected GET "${fixture_json}" "${field}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Incorrect status field: ${field}")
    endif()
endforeach()
file(SHA256 "${FIXTURE}" after)
if(NOT before STREQUAL after OR output MATCHES "fixture-secret")
    message(FATAL_ERROR "Status changed the journal or emitted a private field")
endif()
file(WRITE "${FIXTURE}" [=[{"schema":2,"component":"fixture-secret"}]=])
execute_process(COMMAND "${PROGRAM}" --update-status "${FIXTURE}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(code EQUAL 0 OR NOT output STREQUAL "" OR error MATCHES "fixture-secret")
    message(FATAL_ERROR "An unsupported journal was accepted or copied to output")
endif()
