+bool Mysql_shell::cmd_sdp_capabilities(const std::vector<std::string> &args) {
+  if (args.size() != 1) {
+    print_diag("Usage: \\capabilities");
+    return true;
+  }
+  const auto session = _shell->get_dev_session();
+  if (!session || !session->is_open()) {
+    print_diag("Not connected.");
+    return true;
+  }
+  try {
+    const auto result = session->get_core_session()->query(
+        "SELECT STARDATAPARADISE_CAPABILITIES()");
+    println(result->fetch_one_or_throw()->get_string(0));
+  } catch (const mysqlshdk::db::Error &e) {
+    print_diag(
+        shcore::Exception::mysql_error_with_code(e.what(), e.code()).format());
+  }
+  return true;
+}
+
+bool Mysql_shell::cmd_sdp_metadata(const std::vector<std::string> &args) {
+  if (args.size() != 1) {
+    print_diag("Usage: \\databases or \\tables (no arguments).");
+    return true;
+  }
+  const auto session = _shell->get_dev_session();
+  if (!session || !session->is_open()) {
+    print_diag("Not connected.");
+    return true;
+  }
+
+  const char *query = shcore::str_strip(args.front()) == "\\databases"
+                          ? "SHOW DATABASES"
+                          : "SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_TYPE "
+                            "FROM INFORMATION_SCHEMA.TABLES "
+                            "ORDER BY TABLE_SCHEMA, TABLE_NAME";
+  try {
+    process_sql_result(session->get_core_session()->query(query), {});
+  } catch (const mysqlshdk::db::Error &e) {
+    print_diag(
+        shcore::Exception::mysql_error_with_code(e.what(), e.code()).format());
+  }
+  return true;
+}
